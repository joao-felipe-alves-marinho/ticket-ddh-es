# Backend environment example for local development

# Server
PORT=3000

# KurrentDB (Event Store) - insecure example for local dev
# Format: esdb://<user>:<pass>@<host>:<port>?tls=false
KURRENTDB_CONNECTION_STRING=esdb://admin:changeit@kurrentdb:2113?tls=false

# MongoDB (Read-model)
MONGODB_URI=mongodb://mongo:27017/ticket-ddd-es

# JWT
# Use a strong secret in production (do NOT commit real secrets)
JWT_SECRET=supersecretkey
# Duration strings supported by jsonwebtoken, e.g. 1d, 24h, 1D
JWT_EXPIRES_IN=1D
